{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "editor.tabSize": 2,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "javascript.suggest.autoImports": true,
  "typescript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.rulers": [80],
  "files.associations": {
    "*.tsx": "typescriptreact",
    "Dockerfile": "dockerfile",
    "docker-compose.yml": "yaml"
  },
  "remote.containers.defaultExtensions": [
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "ms-azuretools.vscode-docker"
  ],
  "remote.containers.workspaceMountConsistency": "consistent",
  "remote.containers.buildVolume": "skillshop-node-modules",
  "remote.containers.cacheVolume": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "editor.suggestSelection": "first",
  "editor.wordWrap": "on",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "docker.commands.attach": "exec -it ${containerId} /bin/bash",
  "docker.commands.run": "run --rm -it ${image} /bin/bash",
  "docker.commands.compose": "docker compose",
  "docker.commands.composeBuild": "docker compose build",
  "docker.commands.composeUp": "docker compose up",
  "docker.commands.composeDown": "docker compose down",
  "docker.commands.composeLogs": "docker compose logs",
  "docker.commands.composePs": "docker compose ps",
  "docker.commands.composeExec": "docker compose exec web",
  "docker.commands.composeExecNpm": "docker compose exec web npm",
  "docker.commands.composeExecYarn": "docker compose exec web yarn",
  "docker.commands.composeExecPnpm": "docker compose exec web pnpm",
  "docker.commands.composeExecBash": "docker compose exec web bash",
  "docker.commands.composeExecSh": "docker compose exec web sh",
  "docker.commands.composeExecZsh": "docker compose exec web zsh",
  "docker.commands.composeExecRoot": "docker compose exec --user root web",
  "docker.commands.composeExecRootBash": "docker compose exec --user root web bash",
  "docker.commands.composeExecRootSh": "docker compose exec --user root web sh",
  "docker.commands.composeExecRootZsh": "docker compose exec --user root web zsh",
  "docker.commands.composeExecRootNpm": "docker compose exec --user root web npm",
  "docker.commands.composeExecRootYarn": "docker compose exec --user root web yarn",
  "docker.commands.composeExecRootPnpm": "docker compose exec --user root web pnpm",
  "codeChangeRules": {
    "strictMode": true,
    "preserveExistingFunctionality": true,
    "onlyModifySpecifiedParts": true,
    "maintainSecurityFeatures": true,
    "documentation": {
      "required": true,
      "includeOriginalBehavior": true
    },
    "existingCode": {
      "preserve": true,
      "modification": "forbidden",
      "exceptions": ["explicitly_requested"]
    },
    "coupling": {
      "preferLooseCoupling": true,
      "avoidTightCoupling": true,
      "guidelines": [
        "Use dependency injection",
        "Implement interfaces",
        "Follow SOLID principles",
        "Use composition over inheritance",
        "Keep components independent",
        "Use event-driven architecture when appropriate"
      ]
    }
  }
} 